{
  "name": "@solana-agent-kit/plugin-god-mode",
  "version": "0.0.1",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "private": true,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "clean": "rm -rf dist .turbo node_modules",
    "build": "tsup src/index.ts --dts --clean --format cjs,esm --out-dir dist",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sendaifun/plugin-god-mode.git"
  },
  "homepage": "https://github.com/sendaifun/plugin-god-mode",
  "peerDependencies": {
    "@solana/web3.js": "^1.98.0",
    "solana-agent-kit": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "tsup": "^8.4.0"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "redaxios": "^0.5.1",
    "zod": "^3.24.4"
  }
}
